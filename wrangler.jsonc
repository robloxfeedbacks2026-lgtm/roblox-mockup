{
  "name": "roblox-mockup-app",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roblox-mockup-db",
      "database_id": "PASTE_YOUR_DATABASE_ID_HERE"
    }
  ]
}
